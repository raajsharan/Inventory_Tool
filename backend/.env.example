# ----- Server -----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ----- PostgreSQL -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=inventory_user
DB_PASSWORD=change-me

# ----- JWT -----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h

# ----- AES-256-GCM for asset credentials -----
# Must be exactly 32 bytes hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The app REFUSES TO START if this is left as the placeholder below.
ENCRYPTION_KEY=GENERATE_ME_64_HEX_CHARS

# ----- Logging -----
LOG_LEVEL=info
